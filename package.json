{
  "name": "pi-agents",
  "version": "0.1.0",
  "description": "Subagentes aislados y durables en segundo plano para Pi",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "subagents",
    "durable-execution"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26.10.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm run check:types && npm run check:syntax",
    "check:types": "node scripts/host-types.mjs && tsc --noEmit -p .cache/pi-agents/tsconfig.host.json",
    "check:syntax": "node scripts/check-syntax.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.1",
    "@earendil-works/pi-durable": "1.0.1",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "5.9.3"
  }
}
